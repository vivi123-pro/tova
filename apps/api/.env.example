# Backend only. Never copy these settings into apps/web.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
# Use only the separate demo project's URLs. Values below are placeholders.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# Optional: leave unset for Node's default trusted CA roots (runtime).
# Only needed if the server certificate requires a provider/private CA.
# Relative to API working directory, or an absolute Linux path on Render.
# DATABASE_CA_PATH=certs/prod-ca-2021.crt
GROQ_API_KEY=
# Generate a random secret of at least 32 bytes. No example credentials are usable.
DEMO_TOKEN_SECRET=
# JSON object with exactly two different IDs and salted scrypt password hashes.
# Generate each hash with npm run demo:hash -w api (password on stdin).
DEMO_USERS_JSON={}
DEMO_ACCESS_EXPIRES_AT=
DEMO_TOKEN_TTL_SECONDS=900
DEMO_TOKEN_VERSION=1
