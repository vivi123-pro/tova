{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run generate && tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "generate": "prisma generate --config prisma.generate.config.ts",
    "typecheck": "tsc --noEmit",
    "demo:hash": "node scripts/hash-demo-password.mjs",
    "migrate:status": "prisma migrate status --config prisma7.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "multer": "2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  }
}
